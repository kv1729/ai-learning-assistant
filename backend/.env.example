# Copy to backend/.env and adjust. Never commit .env.
# Matches docker-compose.yml (local development only).
DATABASE_URL=postgresql+psycopg://ala:ala@localhost:5432/ala
TEST_DATABASE_URL=postgresql+psycopg://ala:ala@localhost:5432/ala_test
# JSON list of origins allowed by CORS (the Vite dev server proxies /api, so this is only
# needed when the frontend calls the API from another origin).
CORS_ORIGINS=["http://localhost:5173"]

# --- LLM (Stage 3) ---
# OpenRouter key from https://openrouter.ai/keys (OPENROUTER_API_KEY also works). Never commit it.
LLM_API_KEY=
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# json_schema (strict schema) | json_object (any valid JSON) | none (prompt only)
LLM_STRUCTURED_OUTPUT=json_schema
LLM_TIMEOUT_SECONDS=120
# Model for the eval judge; empty = LLM_MODEL
LLM_JUDGE_MODEL=
